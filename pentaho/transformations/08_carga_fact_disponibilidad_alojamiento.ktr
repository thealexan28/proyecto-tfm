    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Fecha para hacer lookup contra DIM_TIEMPO
var f = fecha;

var anio = f.getYear() + 1900;
var mes = f.getMonth() + 1;
var dia = f.getDate();


// Disponible: t/f -> S/N
if (available_txt == "t") {
  esta_disponible = "S";
} else if (available_txt == "f") {
  esta_disponible = "N";
} else {
  esta_disponible = null;
}

// Limpieza precio calendar
if (precio_calendar_txt == null || precio_calendar_txt == "") {
  precio_calendar = null;
} else {
  var p1 = precio_calendar_txt.replace("$", "").replace(/,/g, "");
  precio_calendar = parseFloat(p1);
}

// Limpieza precio ajustado calendar
if (precio_ajustado_calendar_txt == null || precio_ajustado_calendar_txt == "") {
  precio_ajustado_calendar = null;
} else {
  var p2 = precio_ajustado_calendar_txt.replace("$", "").replace(/,/g, "");
  precio_ajustado_calendar = parseFloat(p2);
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>esta_disponible</name>
        <rename>esta_disponible</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>precio_calendar</name>
        <rename>precio_calendar</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
