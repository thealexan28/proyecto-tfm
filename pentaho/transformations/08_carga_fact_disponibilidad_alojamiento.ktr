  <step>
    <name>Valor JavaScript modificado 2</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// ----------------------------
// Tipo alojamiento
// ----------------------------
if (amenities_original == null || amenities_original == "" || amenities_original == "[]") {
  num_comodidades = 0;
} else {
  var textoAmenities = amenities_original;
  textoAmenities = textoAmenities.replace(/^\[/, "");
  textoAmenities = textoAmenities.replace(/\]$/, "");

  if (textoAmenities.trim() == "") {
    num_comodidades = 0;
  } else {
    var partes = textoAmenities.split(",");
    num_comodidades = partes.length;
  }
}

// ----------------------------
// Valoraciones
// ----------------------------
if (puntuacion_general == null || puntuacion_general == "") {
  rango_puntuacion = "Sin valoración";
} else if (puntuacion_general >= 4.8) {
  rango_puntuacion = "Excelente";
} else if (puntuacion_general >= 4.5) {
  rango_puntuacion = "Buena";
} else if (puntuacion_general >= 4.0) {
  rango_puntuacion = "Regular";
} else {
  rango_puntuacion = "Baja";
}

if (num_resenas == null || num_resenas == 0) {
  volumen_resenas = "Sin reseñas";
} else if (num_resenas &lt; 10) {
  volumen_resenas = "Bajo";
} else if (num_resenas &lt; 50) {
  volumen_resenas = "Medio";
} else {
  volumen_resenas = "Alto";
}

if (reserva_instantanea_txt == "t") {
  reserva_instantanea = "S";
} else if (reserva_instantanea_txt == "f") {
  reserva_instantanea = "N";
} else {
  reserva_instantanea = null;
}

// ----------------------------
// Precio base listings
// ----------------------------
if (precio_base_txt == null || precio_base_txt == "") {
  precio_base = null;
} else {
  var precioLimpio = precio_base_txt.replace("$", "").replace(/,/g, "");
  precio_base = parseFloat(precioLimpio);

function limpiarTexto(v) {
  if (v == null) {
    return null;
  }

  return String(v)
    .replace(/\u00A0/g, " ")     // quita espacios raros tipo non-breaking space
    .replace(/[\t\r\n]/g, " ")   // quita tabuladores y saltos de línea
    .replace(/\s+/g, " ")        // convierte varios espacios en uno
    .trim();                     // quita espacios al principio y al final
}

tipo_propiedad_limpio = limpiarTexto(tipo_propiedad);
tipo_habitacion_limpio = limpiarTexto(tipo_habitacion);
}</jsScript_script>
      </jsScript>
    </jsScripts>
