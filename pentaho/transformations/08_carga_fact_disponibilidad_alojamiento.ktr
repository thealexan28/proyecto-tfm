    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Precio diario: primero calendar.price, si está vacío usamos listings.price
if (precio_calendar != null) {
  precio_diario = precio_calendar;
} else {
  precio_diario = precio_base;
}

// Precio ajustado: adjusted_price, si no price calendar, si no price listings
if (precio_ajustado_calendar != null) {
  precio_ajustado_diario = precio_ajustado_calendar;
} else if (precio_calendar != null) {
  precio_ajustado_diario = precio_calendar;
} else {
  precio_ajustado_diario = precio_base;
}

// Ingreso potencial diario
// Solo lo asignamos a días disponibles.
// Si no está disponible, no lo interpretamos como ingreso real.
if (esta_disponible == "S") {
  if (precio_ajustado_diario != null) {
    ingreso_potencial_diario = precio_ajustado_diario;
  } else {
    ingreso_potencial_diario = 0;
  }
} else {
  ingreso_potencial_diario = 0;
}
</jsScript_script>
      </jsScript>
    </jsScripts>
