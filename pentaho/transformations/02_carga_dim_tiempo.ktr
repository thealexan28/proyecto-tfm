    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var f = fecha;

var anio_aux = f.getYear() + 1900;
var mes_aux = f.getMonth() + 1;
var dia_aux = f.getDate();

dia = dia_aux;
mes = mes_aux;
anio = anio_aux;

if (mes_aux == 1) {
  nombre_mes = "Enero";
} else if (mes_aux == 2) {
  nombre_mes = "Febrero";
} else if (mes_aux == 3) {
  nombre_mes = "Marzo";
} else if (mes_aux == 4) {
  nombre_mes = "Abril";
} else if (mes_aux == 5) {
  nombre_mes = "Mayo";
} else if (mes_aux == 6) {
  nombre_mes = "Junio";
} else if (mes_aux == 7) {
  nombre_mes = "Julio";
} else if (mes_aux == 8) {
  nombre_mes = "Agosto";
} else if (mes_aux == 9) {
  nombre_mes = "Septiembre";
} else if (mes_aux == 10) {
  nombre_mes = "Octubre";
} else if (mes_aux == 11) {
  nombre_mes = "Noviembre";
} else {
  nombre_mes = "Diciembre";
}

trimestre = Math.floor((mes_aux - 1) / 3) + 1;

var dia_semana_num = f.getDay();

if (dia_semana_num == 0) {
  dia_semana = "Domingo";
} else if (dia_semana_num == 1) {
  dia_semana = "Lunes";
} else if (dia_semana_num == 2) {
  dia_semana = "Martes";
} else if (dia_semana_num == 3) {
  dia_semana = "Miércoles";
} else if (dia_semana_num == 4) {
  dia_semana = "Jueves";
} else if (dia_semana_num == 5) {
  dia_semana = "Viernes";
} else {
  dia_semana = "Sábado";
}

if (dia_semana_num == 0 || dia_semana_num == 6) {
  es_fin_semana = "S";
} else {
  es_fin_semana = "N";
}

/*
Criterio sencillo para Málaga:
- Temporada alta: junio, julio, agosto y septiembre
- Temporada media: abril, mayo y octubre
- Temporada baja: noviembre, diciembre, enero, febrero y marzo
*/

if (mes_aux == 6 || mes_aux == 7 || mes_aux == 8 || mes_aux == 9) {
  temporada = "Alta";
} else if (mes_aux == 4 || mes_aux == 5 || mes_aux == 10) {
  temporada = "Media";
} else {
  temporada = "Baja";
}

</jsScript_script>
      </jsScript>
    </jsScripts>
